NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_VERIFIER_MODEL=gpt-5-mini
X_BEARER_TOKEN=
X_FULL_ARCHIVE_ENABLED=false

# Low-cost cascade (daily ingestion + backfill). Any OpenAI-compatible endpoint
# works for open models: DeepInfra, Together, Groq, Fireworks, OpenRouter, vLLM.
OPEN_MODEL_BASE_URL=https://api.deepinfra.com/v1/openai
OPEN_MODEL_API_KEY=
OPEN_MODEL_SCREEN_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
OPEN_MODEL_EXTRACT_MODEL=Qwen/Qwen3-32B
OPEN_MODEL_SCREEN_PRICE_INPUT_PER_MTOK_USD=0.03
OPEN_MODEL_SCREEN_PRICE_OUTPUT_PER_MTOK_USD=0.05
OPEN_MODEL_EXTRACT_PRICE_INPUT_PER_MTOK_USD=0.1
OPEN_MODEL_EXTRACT_PRICE_OUTPUT_PER_MTOK_USD=0.3
VERIFIER_MODE=batch
CASCADE_VERIFIER_MODEL=gpt-5-mini
OPENAI_PRICE_INPUT_PER_MTOK_USD=0.25
OPENAI_PRICE_OUTPUT_PER_MTOK_USD=2
# Set from your X developer console (pay-per-use read price per post).
X_PRICE_PER_POST_READ_USD=0.005
TRANSCRIBE_BASE_URL=https://api.groq.com/openai/v1
TRANSCRIBE_API_KEY=
TRANSCRIBE_MODEL=whisper-large-v3-turbo
TRANSCRIBE_PRICE_PER_HOUR_USD=0.04
DAILY_BUDGET_USD=2
BACKFILL_BUDGET_USD=25
RESOLUTION_DAILY_BUDGET_USD=1

# Legacy xAI-driven X discovery (manual fallback).
XAI_API_KEY=
XAI_MODEL=grok-4-fast-non-reasoning
XAI_DISCOVERY_PROMPT_VERSION=v1
XAI_MAX_SEARCH_RESULTS=20
XAI_MAX_CANDIDATES_PER_WINDOW=10
X_INGESTION_WEEKLY_SOFT_BUDGET_USD=3
X_INGESTION_WEEKLY_HARD_BUDGET_USD=5
ADMIN_EMAILS=
CRON_SECRET=
NEXT_PUBLIC_SITE_ORIGIN=http://localhost:3000
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
SEED_MAX_POSTS_PER_EXPERT=250
SEED_MAX_OPENAI_ITEMS=500
SEED_CONCURRENCY=2
SEED_START_DATE=2021-01-01T00:00:00Z
SEED_END_DATE=
HISTORICAL_MARKET_MAX_DISTANCE_HOURS=12
SUBMISSION_HASH_SALT=replace-me
